OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

## JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_THRESHOLD_MINUTES=10

## Cookie
# Set to true only when served over HTTPS (production).
COOKIE_SECURE=false
SAME_SITE=lax

## AI pre-review of new answers (one extra DeepSeek call per generation).
AI_REVIEW_ENABLED=false
# Rolling 24h budget of reviewer calls across all runs.
AI_REVIEW_DAILY_CAP=200
# Token budget for reviewer output (includes a full suggested answer).
AI_REVIEW_MAX_TOKENS=3000

## Google Sign-In (students). Leave blank to disable the Google button.
# OAuth client (type "Web application") from the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on that client exactly.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the browser is sent after the callback.
FRONTEND_URL=http://localhost:3000

## DB
# Local
DATABASE_URL=postgresql+psycopg://XXXXXXXX:XXXXXXXX@localhost:XXXX/physics_ai_tutor
# Supabase: session pooler
# DATABASE_URL=postgresql+psycopg://postgres.XXXXXXXX:XXXXXXXX@xxx.pooler.supabase.com:5432/postgres
