# Per-checkout override so several worktrees can run side by side.
# Copy to docker-compose.override.yml (gitignored), replace NAME with the
# worktree directory name (e.g. elm), and pick free ports. Start the stack
# with `docker compose -p physics-ai-tutor-NAME up -d`.
services:
  postgres:
    container_name: physics-ai-tutor-NAME-postgres
    ports: !override
      - "5435:5432"
  postgres-test:
    container_name: physics-ai-tutor-NAME-postgres-test
    ports: !override
      - "5436:5432"
  backend:
    container_name: physics-ai-tutor-NAME-backend
    environment:
      BACKEND_CORS_ORIGINS: '["http://localhost:3001","http://127.0.0.1:3001"]'
    ports: !override
      - "8001:8000"
  frontend:
    container_name: physics-ai-tutor-NAME-frontend
    ports: !override
      - "3001:3000"
